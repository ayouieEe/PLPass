{
  "name": "plpass",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "vite build && tsc -p tsconfig.electron.json && copy /Y electron\\preload.cjs dist-electron\\electron\\preload.cjs > NUL",
    "build:desktop:staging-fault": "vite build --mode staging-fault && tsc -p tsconfig.electron.json && copy /Y electron\\preload.cjs dist-electron\\electron\\preload.cjs > NUL",
    "build:desktop:staging-lease-expiry": "vite build --mode staging-lease-expiry && tsc -p tsconfig.electron.staging-lease-expiry.json && copy /Y electron\\preload.staging-lease-expiry.cjs dist-electron\\electron\\preload.cjs > NUL",
    "build:desktop:staging-concurrent-window": "vite build --mode staging-concurrent-window && tsc -p tsconfig.electron.staging-concurrent-window.json && copy /Y electron\\preload.staging-lease-expiry.cjs dist-electron\\electron\\preload.cjs > NUL",
    "build:desktop:staging-bounded-retry": "vite build --mode staging-bounded-retry && tsc -p tsconfig.electron.json && copy /Y electron\\preload.cjs dist-electron\\electron\\preload.cjs > NUL",
    "build:desktop:staging-terminal-conflict": "vite build --mode staging-terminal-conflict && tsc -p tsconfig.electron.staging-terminal-conflict.json && copy /Y electron\\preload.cjs dist-electron\\electron\\preload.cjs > NUL",
    "desktop": "npm run build:desktop && electron .",
    "desktop:staging-fault": "npm run build:desktop:staging-fault && electron .",
    "desktop:staging-lease-expiry": "npm run build:desktop:staging-lease-expiry && electron .",
    "desktop:staging-concurrent-window": "npm run build:desktop:staging-concurrent-window && electron .",
    "desktop:staging-bounded-retry": "npm run build:desktop:staging-bounded-retry && electron .",
    "desktop:staging-terminal-conflict": "npm run build:desktop:staging-terminal-conflict && electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:supabase": "playwright test --config=playwright.supabase.config.ts",
    "test:visual": "playwright test --project=visual-chromium",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:release": "node scripts/release-preflight.mjs",
    "check:supabase": "node scripts/check-supabase-readiness.mjs",
    "check:supabase:linked": "node scripts/check-supabase-linked.mjs",
    "test:supabase:local": "node scripts/test-local-supabase-integration.mjs",
    "preview": "vite preview",
    "generate:db-types": "supabase gen types --linked --lang typescript --schema public > src/lib/supabase/database.types.ts",
    "check:db-types": "tsc --noEmit --pretty false src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-table": "^8.20.6",
    "@types/qrcode": "^1.5.5",
    "@vladmandic/human": "^3.3.6",
    "@zxing/browser": "^0.2.1",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "selfsigned": "^5.5.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "supabase": "^2.108.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "electron@38.1.0": true,
    "esbuild@0.25.12": true
  }
}
