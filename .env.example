# FastAPI facial recognition (server-side only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
DEEPFACE_MODEL=SFace
DEEPFACE_DETECTOR=opencv
DEEPFACE_MIN_SIMILARITY=0.85
DEEPFACE_AMBIGUITY_MARGIN=0.12
DEEPFACE_MIN_CAPTURE_FRAMES=3
