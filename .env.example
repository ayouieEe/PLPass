NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Vite fallbacks
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
VITE_API_BASE_URL=http://localhost:8000

# FastAPI facial recognition (server-side only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Keep this only in the server environment. Never use VITE_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR=retinaface
# Development defaults only: calibrate against PLPass's consented test set.
FACE_COSINE_DISTANCE_THRESHOLD=0.32
FACE_MINIMUM_MATCH_MARGIN=0.04
FACE_MIN_FACE_PIXELS=110
DEEPFACE_MIN_CAPTURE_FRAMES=1
