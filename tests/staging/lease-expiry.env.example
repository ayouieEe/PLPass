# Copy to the ignored repository-root file .env.staging-lease-expiry.local.
# Fill only the approved staging public URL and publishable key. Never place a
# database password, service-role key, or production value in this file.
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_STAGING_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_STAGING_PUBLISHABLE_KEY

# The following Vite settings are consumed while building the renderer only.
# Set the Electron process controls in PowerShell, as documented in the runbook.
VITE_PLPASS_STAGING_LEASE_EXPIRY_ENABLED=true

# Set to claim for the first app run; change to recover only after the app has
# exited and the five-second lease has expired.
VITE_PLPASS_STAGING_LEASE_EXPIRY_PHASE=claim
